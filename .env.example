# ChicagoNomadNet Environment Configuration
# Copy to .env and customize for your setup

# =============================================================================
# ZIM Host Settings
# =============================================================================
ZIM_PATH=/path/to/zim/files/
ZIM_AUTHKEY=your_secret_key_here

# =============================================================================
# ZimBot Settings
# =============================================================================
ZIMBOT_SQLITE_PATH=./zimbot.db
ZIMBOT_MODEL_PATH=/path/to/local/models/
ZIMBOT_LAZY_EMBEDDING=1

# Remote Inference Settings
# Set ZIMBOT_REMOTE_INFERENCE=0 to use local models instead
ZIMBOT_REMOTE_INFERENCE=1
ZIMBOT_LLM_URL=http://your-lmstudio-server:1234
ZIMBOT_EMBEDDING_URL=http://your-lmstudio-server:1234
ZIMBOT_LLM_TIMEOUT=120
ZIMBOT_EMBEDDING_REMOTE_MODEL=text-embedding-all-minilm-l6-v2-embedding

# =============================================================================
# Security Now Settings
# =============================================================================
SN_LLAMA_URL=http://your-lmstudio-server:1234
SN_AUTHKEY=your_secret_key_here
